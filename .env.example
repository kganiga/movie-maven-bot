# =======================================================
# Movie Maven Bot - Environment Configuration
# =======================================================

# --- Telegram Bot Configuration ---
# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Secret token to authenticate webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_here

# Optional: Custom domain URL (e.g., https://your-project.vercel.app).
# Note: On Vercel, this is auto-detected automatically. Do NOT prefix with VERCEL_
APP_URL=https://your-project.vercel.app

# --- The Movie Database (TMDB) API ---
# API key obtained from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# --- Quota Management ---
# Identifier for this bot
BOT_ID=movie-maven

# Free requests allowed per Telegram user per day (default: 5)
FREE_REQUESTS_PER_DAY=5

# Timezone for daily quota reset (default: Asia/Kolkata)
QUOTA_TIMEZONE=Asia/Kolkata

# --- Upstash Redis (100% Free Serverless Key-Value Store) ---
# Create a free database at https://console.upstash.com/ (no credit card required)
# 10,000 free commands/day forever.
UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
